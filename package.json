{
  "name": "anim-prison-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "动物监狱经营小程序 E2E 开发验证环境 monorepo（一期）",
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:miniprogram": "eslint miniprogram scripts --ext .js",
    "build": "node scripts/devtools-build.js",
    "build:devtools": "node scripts/devtools-build.js",
    "devtools": "node scripts/devtools-build.js --open",
    "e2e": "DISPLAY=${WDT_DISPLAY:-:97} jest -c e2e/jest.config.js --runInBand",
    "e2e:spike": "node e2e/spike/ensure-devtools.js && DISPLAY=${WDT_DISPLAY:-:97} jest e2e/spike/spike.test.js --runInBand --forceExit"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "miniprogram-automator": "^0.12.1"
  }
}
