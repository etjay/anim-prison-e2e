.thumb {
  font-size: 64rpx;
}
.info {
  flex: 1;
  min-width: 0;
}
.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.animal-name {
  font-size: 32rpx;
  font-weight: 700;
}
.nickname {
  font-size: 24rpx;
  font-weight: 400;
}
.remain-badge {
  background: #111;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.bar-track {
  margin: 14rpx 0 8rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
}
.need-tip {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
