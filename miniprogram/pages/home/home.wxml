<view class="container">
  <view class="card" wx:if="{{animal}}">
    <view class="row">
      <view class="animal">
        <text class="animal-emoji">{{animal.emoji}}</text>
        <view>
          <view class="animal-name">{{animal.name}}</view>
          <view class="animal-species">物种：{{animal.species}}</view>
        </view>
      </view>
      <view class="mood">心情 {{animal.mood}}</view>
    </view>

    <!-- M8（ANIM-15）：环境/主动语料气泡，客户端只渲染 corpus.text；徽标仅作调试 -->
    <view class="corpus-bubble" wx:if="{{corpus && corpus.text}}">
      <view class="corpus-bubble__tail"></view>
      <view class="corpus-bubble__text">{{corpus.text}}</view>
      <view class="corpus-bubble__tag" wx:if="{{corpus.itemId}}">{{corpus.source || 'rule'}} · {{corpus.itemId}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{!loading}}">
    <view class="title">监狱地图</view>
    <view class="map-grid">
      <view class="map-cell" wx:for="{{cells}}" wx:key="index">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="hint">{{error}}</view>

  <view class="btn" bindtap="gotoCanteen">去食堂领餐</view>
  <view class="btn btn--ghost" bindtap="gotoLogin">重新登录</view>
</view>
