.me-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.me-avatar {
  font-size: 88rpx;
}
.me-info {
  flex: 1;
  font-size: 30rpx;
}
.me-name {
  font-weight: 700;
  font-size: 34rpx;
  margin-bottom: 6rpx;
}
.level-badge {
  background: #ff9f1c;
  color: #111;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 12rpx 22rpx;
}
.me-label {
  font-size: 30rpx;
  flex: 1;
}
.me-value {
  font-size: 26rpx;
}
