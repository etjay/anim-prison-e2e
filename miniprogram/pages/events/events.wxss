.status-line {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.status-chip {
  background: #eee;
  border: 2rpx solid #ccc;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
}

.link {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
}

.event-item--selected {
  background: #fff7ec;
  border: 2rpx solid #ff9f1c;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.event-emoji {
  font-size: 48rpx;
}
.event-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.event-go {
  font-size: 26rpx;
  font-weight: 600;
}

.option {
  border: 2rpx solid #ccc;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
  background: #fff;
}
.option--chosen {
  background: #fff7ec;
  border-color: #ff9f1c;
}
.option-label {
  font-size: 30rpx;
  font-weight: 600;
}
.option-effect {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.result-card {
  margin-top: 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}
