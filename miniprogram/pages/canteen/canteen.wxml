<view class="container">
  <view class="card">
    <view class="title">食堂</view>
    <view class="subtitle">给 {{animalName}} 提供一次互动（喂食）。</view>
    <view class="btn {{submitting ? 'btn--disabled' : ''}}" bindtap="onFeed">
      {{submitting ? '提交中…' : '🍲 喂食一次'}}
    </view>
    <view wx:if="{{resultMsg}}" class="success">{{resultMsg}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <!-- M8（ANIM-15）：互动后即时反馈语料气泡（P0），客户端只渲染 corpus.text -->
    <view class="corpus-bubble" wx:if="{{corpus && corpus.text}}">
      <view class="corpus-bubble__tail"></view>
      <view class="corpus-bubble__text">{{corpus.text}}</view>
      <view class="corpus-bubble__tag" wx:if="{{corpus.itemId}}">{{corpus.source || 'rule'}} · {{corpus.itemId}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{rating}}">
    <view class="title">评分 / 满意度</view>
    <view class="row">
      <text>综合评分</text>
      <text class="rating">{{rating.score}}</text>
    </view>
    <view class="row">
      <text>满意度</text>
      <text>{{rating.satisfaction}}%</text>
    </view>
    <view class="row">
      <text>互动次数</text>
      <text>{{rating.count}}</text>
    </view>
  </view>
</view>
