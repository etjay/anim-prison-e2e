/* 全局样式 */
page {
  background: #f4f1ea;
  color: #333;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.btn {
  background: #4a7c59;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin-top: 24rpx;
}

.btn--disabled {
  background: #b8c9bd;
}

.btn--ghost {
  background: #eef3ef;
  color: #4a7c59;
}

.error {
  color: #c0392b;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.hint {
  color: #8a9a8f;
  font-size: 24rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.map-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.map-cell {
  width: calc(33.33% - 11rpx);
  aspect-ratio: 1;
  background: #e8f0e9;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}