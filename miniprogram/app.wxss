/* 全局样式 */
page {
  background: #f4f1ea;
  color: #333;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.btn {
  background: #4a7c59;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin-top: 24rpx;
}

.btn--disabled {
  background: #b8c9bd;
}

.btn--ghost {
  background: #eef3ef;
  color: #4a7c59;
}

.error {
  color: #c0392b;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.hint {
  color: #8a9a8f;
  font-size: 24rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.map-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.map-cell {
  width: calc(33.33% - 11rpx);
  aspect-ratio: 1;
  background: #e8f0e9;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

/* M8 语料气泡（ANIM-15）：客户端只渲染 corpus.text；
   source/itemId/ctx 仅作调试徽标，不参与渲染逻辑。 */
.corpus-bubble {
  position: relative;
  background: #fffdf5;
  border: 2rpx solid #e8dcae;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}
.corpus-bubble__tail {
  position: absolute;
  top: -16rpx;
  left: 40rpx;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 16rpx solid #e8dcae;
}
.corpus-bubble__text {
  font-size: 28rpx;
  color: #5a4a1e;
  line-height: 1.7;
}
.corpus-bubble__tag {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #b39a4e;
  background: #f6efdb;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}